# 复制为 .env 后填写；.env 已在 .gitignore 中排除，禁止提交真实密钥。

# ---- LLM ----
# 选择 profile：local_proxy | deepseek_official | openai
LLM_PROFILE=local_proxy
LLM_API_KEY=
# 可选：覆盖当前 profile 的地址与模型
LLM_BASE_URL=
LLM_MODEL=

# ---- OCR 文件外发 ----
# auto | s3 | proxy | passthrough | temp_host
OCR_EXPOSER=auto
# B 级：自托管文件代理的公网基址（本机无公网 IP 时留空）
FILE_PROXY_BASE_URL=
# A 级：S3 兼容对象存储（阿里云 OSS / 腾讯云 COS / MinIO）
OSS_ENDPOINT=
OSS_BUCKET=
OSS_AK=
OSS_SK=
